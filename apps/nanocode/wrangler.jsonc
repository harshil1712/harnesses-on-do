{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "harnesses-on-do-nanocode",
	"main": "src/index.ts",
	"upload_source_maps": true,
	"compatibility_date": "2026-11-10",
	"minify": true,
	// Reached only through apps/web's NANOCODE service binding.
	"workers_dev": false,
	"preview_urls": false,
	"ai": { "binding": "AI", "remote": true },
	"durable_objects": {
		"bindings": [
			{ "name": "SESSIONS", "class_name": "AgentSession" },
			{ "name": "Metering", "class_name": "Metering" },
		],
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentSession", "Metering"] }],
	// Nanocode's App.Env, with the reference Worker's values. WORKERS_AI_ACCOUNT_ID is set
	// in .dev.vars locally and as a secret in production (see the README).
	"vars": {
		"MODEL_AUTH": "api_key",
		"RECOVERY_DELAY_MS": "5000",
		"RECOVERY_BACKOFF_MS": "3600000",
		"EVENT_STREAM_KEEPALIVE_MS": "5000",
		"EVENT_PAGE_SIZE": "128",
		"EVENT_TAIL_BYTES": "4194304",
		"EVENT_COALESCE_MS": "100",
		"MODEL_SOCKET_LINGER_MS": "30000",
		"MODEL_PRIME_IDLE_MS": "15000",
		"RUNTIME_MEMORY_BUDGET_BYTES": "67108864",
		"REMOTE_MAX_FRAME_BYTES": "1048576",
		"REMOTE_TIMEOUT_MS": "30000",
	},
	"observability": {
		"enabled": true,
		"traces": { "enabled": true },
	},
}
