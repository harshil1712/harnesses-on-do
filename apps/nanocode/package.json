{
	"name": "@harnesses-on-do/nanocode",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry wrangler dev --port 5175 --inspector-port 9243",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"typecheck": "tsc --noEmit",
		"types": "wrangler types env.d.ts --include-runtime false"
	},
	"dependencies": {
		"@harnesses-on-do/shared": "workspace:*",
		"nanocode-ts": "https://github.com/nanocodexyz/nanocode-ts/releases/download/build-189e0e1/nanocode-ts-189e0e1.tgz"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261109.1",
		"typescript": "^6.0.3",
		"wrangler": "^4.159.0"
	}
}
