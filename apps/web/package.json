{
	"name": "@harnesses-on-do/web",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"scripts": {
		"build:kernel": "RUSTC=\"$(rustup which --toolchain 1.95.0 rustc)\" rustup run 1.95.0 cargo build --manifest-path codex-kernel/Cargo.toml --target wasm32-unknown-unknown --release",
		"dev": "pnpm run build:kernel && CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry vite dev",
		"build": "pnpm run build:kernel && vite build",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"types": "wrangler types env.d.ts --include-runtime false"
	},
	"dependencies": {
		"@ai-sdk/provider": "^4.0.37",
		"@ai-sdk/react": "^4.0.170",
		"@cloudflare/ai-chat": "^0.12.2",
		"@cloudflare/computer": "^0.10.0",
		"@cloudflare/kumo": "^2.18.0",
		"@cloudflare/think": "^0.23.0",
		"@cloudflare/worker-bundler": "^0.2.6",
		"@earendil-works/chord": "~1.5.0",
		"@earendil-works/pi-ai": "~1.5.0",
		"@earendil-works/pi-durable": "~1.5.0",
		"@earendil-works/pi-schema": "~1.5.0",
		"@earendil-works/pi-telemetry": "~1.5.0",
		"@flue/react": "2.3.0",
		"@flue/sdk": "2.3.0",
		"@opencode/plugin": "2.0.24",
		"@opencode/sdk": "2.0.24",
		"@phosphor-icons/react": "^2.1.10",
		"@platformatic/vfs": "^0.5.0",
		"@harnesses-on-do/shared": "workspace:*",
		"@streamdown/code": "^2.0.0",
		"agents": "^0.33.0",
		"ai": "^7.0.166",
		"just-bash": "^3.6.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"streamdown": "^2.7.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.68.0",
		"@cloudflare/workers-types": "^5.20261109.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"wrangler": "^4.159.0"
	}
}
